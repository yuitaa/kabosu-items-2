{components: {"minecraft:custom_name": {bold: 1b, color: "#990033", italic: 0b, text: "壊裂かぼす"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "white", italic: 0b, text: "その危うさは例え管理者であっても扱いに困るほど。"}, {color: "white", italic: 0b, text: "万が一爆ぜようものなら、"}, {color: "white", italic: 0b, text: "辺り一面は燎原と化すだろう。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:slime_ball"}
