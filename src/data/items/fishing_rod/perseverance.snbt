{components: {"minecraft:attribute_modifiers": [{amount: 5.0, id: "minecraft:fffe1ea9-0000-56d3-0000-a61fffff525a", operation: "add_value", slot: "mainhand", type: "minecraft:max_health"}], "minecraft:custom_name": {bold: 1b, color: "#CC6633", extra: [{color: "white", text: "を以て"}, {color: "dark_aqua", text: "励精"}], italic: 0b, text: "堅忍"}, "minecraft:enchantments": {"minecraft:luck_of_the_sea": 3, "minecraft:lure": 4, "minecraft:mending": 1, "minecraft:unbreaking": 3}, "minecraft:lore": [{color: "#9ACD32", italic: 1b, text: "釣りは忍耐だ。"}, {color: "#9ACD32", italic: 1b, text: ""}, {color: "#9ACD32", italic: 1b, text: "心静かに浮きをみつめ、"}, {color: "#9ACD32", italic: 1b, text: "それは延いては己の心をみつめ、"}, {color: "#9ACD32", italic: 1b, text: "精神統一の果てに君は何を見た？"}], "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:fishing_rod"}
