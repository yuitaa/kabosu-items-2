{components: {"minecraft:custom_name": {italic: 0b, text: "強化された深層岩"}, "minecraft:lore": [{color: "yellow", extra: [{color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "建築の装飾にどうぞ。"}, {color: "dark_purple", italic: 0b, text: ""}, {color: "#FF0000", italic: 0b, text: "※設置すると壊すのが大変です。"}, {color: "#FF0000", italic: 0b, text: "取り扱いにはご注意ください。"}, {color: "#FF0000", italic: 0b, text: ""}, {color: "#FF0000", extra: [{color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "破壊依頼はalbacore_tunaまで。"}, {color: "dark_purple", italic: 0b, text: ""}]}, count: 1, id: "minecraft:reinforced_deepslate"}
