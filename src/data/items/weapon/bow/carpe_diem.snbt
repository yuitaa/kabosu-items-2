{components: {"minecraft:attribute_modifiers": [{amount: -0.01, id: "minecraft:fffe1e40-0000-3ed0-0000-d568ffff8260", operation: "add_value", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "#336666", italic: 0b, text: "カルペ・ディエム"}, "minecraft:enchantments": {"minecraft:flame": 1, "minecraft:infinity": 1, "minecraft:mending": 1, "minecraft:unbreaking": 3}, "minecraft:lore": [{color: "#FFFF88", italic: 1b, text: "──例えば、"}, {color: "#FFFF88", italic: 1b, text: "アウシュヴィッツにおける絶望的な一日にも、"}, {color: "#FFFF88", italic: 1b, text: "本当にその日の花が存在するのか。"}, {color: "#FFFF88", italic: 1b, text: "この問を逃げることなく考えるならば──"}, {color: "#FFFF88", italic: 1b, text: "それはすでに、"}, {color: "#FFFF88", italic: 1b, text: "生活における祈りという問題の"}, {color: "#FFFF88", italic: 1b, text: "核心に触れていることにもなろう。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:bow"}
