{components: {"minecraft:custom_name": {extra: [{bold: 1b, color: "dark_purple", text: "DESU DEBIRU"}, {bold: 1b, color: "red", text: "との契約書"}], italic: 0b, text: " "}, "minecraft:enchantments": {"minecraft:fire_aspect": 2}, "minecraft:lore": [{italic: 0b, text: ""}, {color: "gold", italic: 0b, text: "”穴”の奥底で待機していた闇神との契約書。"}, {color: "gold", italic: 0b, text: ""}, {color: "gold", italic: 0b, text: "市長は”彼”にアイテムの守衛を依頼していたが"}, {color: "gold", italic: 0b, text: "契約は履行されなかったようだ。"}], "minecraft:repair_cost": 99999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:stone_sword"}
