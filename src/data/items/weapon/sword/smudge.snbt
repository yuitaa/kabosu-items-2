{components: {"minecraft:lore": [{color: "white", text: "虚妄を鎮め、正体を見せよ。", italic: 0b}, {color: "white", text: "妄念を鎮め、素顔よ現わせよ。", italic: 0b}, "", {color: "white", text: "此の地、この刻、示せよ、現れよ。", italic: 0b}, {color: "white", text: "真形、真名、消すな、隠すな。", italic: 0b}, "", {color: "#7CAC68", text: "此岸、彼岸、前世、来世。", italic: 0b}], "minecraft:attribute_modifiers": [{amount: 7.0, id: "minecraft:1792412673707", slot: "mainhand", type: "minecraft:attack_speed", operation: "add_value"}, {amount: 3.0, id: "minecraft:1792412673708", slot: "mainhand", type: "minecraft:entity_interaction_range", operation: "add_value"}, {amount: 2.0, id: "minecraft:1792412673709", slot: "mainhand", type: "minecraft:attack_damage", operation: "add_value"}], "minecraft:enchantments": {"minecraft:smite": 5, "minecraft:looting": 3, "minecraft:fire_aspect": 3}, "minecraft:unbreakable": {}, "minecraft:custom_name": {color: "#C48ACC", text: "スマッジソード", bold: 1b, italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:stone_sword"}
