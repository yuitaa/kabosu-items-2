{components: {"minecraft:custom_data": {cmdi: {command: "vanishment", params: {}}}, "minecraft:custom_name": {extra: [{bold: 1b, color: "light_purple", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "バニッシュメント・ディス・ワールド", underlined: 0b}], text: ""}, "minecraft:lore": [{extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "術者がイデアに直接アクセスすることにより現実境界線を歪ませ、", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "過剰活動をさせたシナプスより自らの心象風景を外界へ投影、", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "世界そのものを一瞬にして塗り替える窮極の禁呪。", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "固有結界と呼称されることもある。", underlined: 0b}], text: ""}]}, count: 1, id: "minecraft:end_crystal"}
