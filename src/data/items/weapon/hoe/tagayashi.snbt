{components: {"minecraft:custom_name": {color: "dark_red", extra: [" ", {bold: 1b, color: "red", text: "-TAGAYASHI-"}], italic: 0b, text: "魔鍬"}, "minecraft:enchantments": {"minecraft:efficiency": 5, "minecraft:fire_aspect": 2, "minecraft:knockback": 2, "minecraft:sharpness": 5, "minecraft:silk_touch": 1, "minecraft:unbreaking": 3}, "minecraft:lore": [{italic: 0b, text: ""}, {color: "dark_purple", italic: 0b, text: "暗黒の力を秘めた禍々しい鍬。"}, {color: "dark_purple", italic: 0b, text: "秘められし力そのものは強大だが、"}, {color: "dark_purple", italic: 0b, text: "いかんせん鍬なので危険性や殺傷力はそれなり。"}], "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:netherite_hoe"}
