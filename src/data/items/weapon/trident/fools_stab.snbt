{components: {"minecraft:attribute_modifiers": [{amount: 9.0, id: "minecraft:fffe1bfa-0000-5c86-0000-2c4fffff46f4", operation: "add_value", slot: "mainhand", type: "minecraft:attack_damage"}, {amount: 0.5, id: "minecraft:fffe1bfa-0000-5cea-0000-2c4fffff462c", operation: "add_value", slot: "mainhand", type: "minecraft:attack_knockback"}, {amount: -3.0, id: "minecraft:fffe1bfa-0000-5d4e-0000-2c4fffff4564", operation: "add_value", slot: "mainhand", type: "minecraft:attack_speed"}], "minecraft:custom_name": {bold: 1b, color: "#8D6449", extra: [{color: "white", text: "の一刺し"}], italic: 0b, text: "愚者"}, "minecraft:enchantments": {"minecraft:fortune": 3, "minecraft:loyalty": 3}, "minecraft:lore": [{color: "white", text: "善、積まざれば、以て名を成すに足らず。"}, {color: "white", italic: 1b, text: "悪、積まざれば、以て身を亡ぼすに足らず。"}, {color: "white", italic: 1b, text: "小人は小善を以て益无しと為して為さざるなり。"}, {color: "white", italic: 1b, text: "小悪を以て傷う无しと為して去らざるなり。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers", "minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:unbreakable": {}}, count: 1, id: "minecraft:trident"}
