{components: {"minecraft:lore": [{color: "white", text: "長い柄に鈎（かぎ）爪が取り付けられた武器。", italic: 0b}, {color: "white", text: "相手を馬から引きずり下ろしたり、足を引っ掛けて倒したり、", italic: 0b}, {color: "white", text: "押さえこみ捕らえる。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 4}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "green", text: "バトルフック", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:diamond_axe"}
