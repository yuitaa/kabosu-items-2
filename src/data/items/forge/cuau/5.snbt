{components: {"minecraft:lore": [{color: "white", text: "八分挿し（はちぶさし）と呼ばれる、", bold: 1b, italic: 1b}, {color: "white", text: "五分挿しよりもさらに多くの", bold: 1b, italic: 1b}, {color: "white", text: "金を混ぜた銅合金で", bold: 1b, italic: 1b}, {color: "white", text: "打ちなおされた剣。", bold: 1b, italic: 1b}], "minecraft:attribute_modifiers": [], "minecraft:enchantments": {"minecraft:bane_of_arthropods": 5, "minecraft:sharpness": 4, "minecraft:mending": 1, "minecraft:knockback": 2, "minecraft:smite": 5, "minecraft:unbreaking": 3, "minecraft:looting": 3, "minecraft:sweeping_edge": 3}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {color: "gold", extra: [" ", {color: "white", text: "赤銅の剣"}, {color: "yellow", text: "+5"}], text: "SR++", italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:netherite_sword"}
