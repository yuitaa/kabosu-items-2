{components: {"minecraft:lore": [{color: "dark_aqua", text: "悪魔が青空を蹂躙する。", bold: 1b, italic: 1b}, {color: "dark_aqua", text: "それは笑いかけるように。", bold: 1b, italic: 1b}, {color: "dark_aqua", text: "心臓を掴み、謡うように。", bold: 1b, italic: 1b}], "minecraft:attribute_modifiers": [], "minecraft:enchantments": {"minecraft:bane_of_arthropods": 6, "minecraft:sharpness": 6, "minecraft:mending": 1, "minecraft:knockback": 1, "minecraft:smite": 6, "minecraft:unbreaking": 3, "minecraft:looting": 3, "minecraft:fire_aspect": 3, "minecraft:sweeping_edge": 3}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {color: "blue", extra: [" ", {color: "white", text: "ロノウェの戒律"}], text: "LR", italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:netherite_sword"}
