{components: {"minecraft:lore": [{color: "white", text: "細身で先端の鋭く尖った刺突用の片手剣。", italic: 0b}, {color: "white", text: "護身あるいは決闘の際の武器として用いられた。", italic: 0b}, {color: "white", text: "貴族の間で騎士道精神の象徴や、", italic: 0b}, {color: "white", text: "過度の装飾を施された芸術品として扱われた。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 5}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "yellow", text: "レイピア", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:iron_sword"}
