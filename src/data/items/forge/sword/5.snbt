{components: {"minecraft:lore": [{color: "white", text: "ノルマン人が使用する幅広の刀。", italic: 0b}, {color: "white", text: "隙間のないプレートメイルが主流だった時代、", italic: 0b}, {color: "white", text: "重量で相手の鎧を叩き斬ることを目的として作られた。", italic: 0b}, {color: "white", text: "名前は鎌（カマ）を意味するラテン語のファルクスに由来。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 4}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "green", text: "ファルシオン", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:diamond_sword"}
