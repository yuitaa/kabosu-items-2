{components: {"minecraft:lore": [{color: "white", text: "刀身が波打つ剣の総称。", italic: 0b}, {color: "white", text: "ドイツ語ではフランベルクという。", italic: 0b}, {color: "white", text: "刀身の揺らめきが炎のように見える為、", italic: 0b}, {color: "white", text: "フランス語で炎を意味するフランボワヤンにちなんでこの名前がついた。", italic: 0b}, {color: "white", text: "治りづらい傷を作るため、", italic: 0b}, {color: "white", text: "「死よりも苦痛を与える剣」", italic: 0b}, {color: "white", text: "として知られる。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 5, "minecraft:fire_aspect": 1}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "yellow", text: "フランベルジェ", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:diamond_sword"}
