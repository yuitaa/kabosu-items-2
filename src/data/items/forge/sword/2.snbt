{components: {"minecraft:lore": [{color: "white", text: "１４世紀から１７世紀にかけてスコットランド人に", italic: 0b}, {color: "white", text: "使用されていた両手持ちの大剣。", italic: 0b}, {color: "white", text: "当時のヨーロッパにおける両手用剣としては小ぶりで、", italic: 0b}, {color: "white", text: "素早い剣の動きが恐れられた。", italic: 0b}, {color: "white", text: "１８世紀になって片手用刀剣に変わっていった。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 4}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "green", text: "クレイモア", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:iron_sword"}
