{components: {"minecraft:lore": [{color: "white", text: "葛天氏の楽は、八篇の詩より成る。", italic: 0b}, {color: "white", text: "一は「戴民」", italic: 0b}, {color: "white", text: "二は「玄鳥」", italic: 0b}, {color: "white", text: "三は「遂草木」", italic: 0b}, {color: "white", text: "四は「奮五穀」", italic: 0b}, {color: "white", text: "五は「敬天常」", italic: 0b}, {color: "white", text: "六は「見帝功」", italic: 0b}, {color: "white", text: "七は「依地徳」", italic: 0b}, {color: "white", text: "八は「総禽獣之極」", italic: 0b}], "minecraft:attribute_modifiers": [{amount: 0.05d, id: "minecraft:1790978992289", slot: "chest", type: "minecraft:movement_speed", operation: "add_value"}, {amount: 3.0d, id: "minecraft:1790978992290", slot: "chest", type: "minecraft:armor", operation: "add_value"}], "minecraft:enchantments": {"minecraft:projectile_protection": 4, "minecraft:fire_protection": 4, "minecraft:protection": 4}, "minecraft:unbreakable": {}, "minecraft:custom_name": {color: "#68F384", text: "原初の楽舞", bold: 1b, italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:elytra"}
