{components: {"minecraft:lore": [{color: "gray", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "会心ダメージ", bold: 1b, italic: 0b}, {color: "white", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "４０．２％", bold: 1b, italic: 0b}, {color: "dark_purple", text: "", italic: 0b}, {color: "gray", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "基礎攻撃力", bold: 1b, italic: 0b}, {color: "white", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "６２１", bold: 1b, italic: 0b}, {color: "dark_purple", text: "", italic: 0b}, {color: "dark_aqua", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "Ｌｖ．９０／９０", bold: 1b, italic: 0b}, {color: "dark_gray", extra: [{color: "dark_purple", text: "", bold: 0b, italic: 0b}], text: "精錬ランク１", bold: 1b, italic: 0b}, {color: "yellow", extra: [{color: "dark_purple", text: "", italic: 0b}], text: "★★★★★", italic: 0b}, {color: "dark_purple", text: "", italic: 0b}, {color: "white", text: "全元素ダメージ＋１２％、「霧切の巴紋」", italic: 0b}, {color: "white", text: "の効果を獲得できる。霧切の巴紋を１／２／", italic: 0b}, {color: "white", text: "３層有する時、自身元素タイプの元素ダ", italic: 0b}, {color: "white", text: "メージ＋８／１６／２８％。霧切の巴紋は次の", italic: 0b}, {color: "white", text: "各状況において獲得できる。通常攻撃で", italic: 0b}, {color: "white", text: "元素ダメージを与えたとき、継続時間５秒", italic: 0b}, {color: "white", text: "の霧切の巴紋を１層獲得する。元素爆発", italic: 0b}, {color: "white", text: "を発動した時、継続時間１０秒の霧切の巴", italic: 0b}, {color: "white", text: "紋を１層獲得する。また、キャラクターの", italic: 0b}, {color: "white", text: "元素エネルギーが１００％未満の場合、霧", italic: 0b}, {color: "white", text: "切の巴紋を１層獲得する、この霧切の巴", italic: 0b}, {color: "white", text: "紋は元素エネルギーが満タンになると消", italic: 0b}, {color: "white", text: "失する。霧切の巴紋の継続時間は層ごと", italic: 0b}, {color: "white", text: "に独立している。", italic: 0b}], "minecraft:enchantments": {"minecraft:sharpness": 5, "minecraft:mending": 1, "minecraft:silk_touch": 1, "minecraft:looting": 1}, "minecraft:unbreakable": {}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:custom_name": {color: "gold", text: "霧切の廻光", bold: 1b, italic: 0b}, "minecraft:repair_cost": 999}, count: 1, id: "minecraft:netherite_sword"}
