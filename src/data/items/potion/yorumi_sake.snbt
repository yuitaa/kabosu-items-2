{components: {"minecraft:custom_data": {CustomPotionEffects: [{Ambient: 0, Amplifier: 0, Duration: 600, Id: 22, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 29, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 30, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 12, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 24, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 3, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 21, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 32, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 6, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 14, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 8, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 16, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 10, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 11, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 28, ShowIcon: 1, ShowParticles: 1}, {Ambient: 0, Amplifier: 0, Duration: 600, Id: 1, ShowIcon: 1, ShowParticles: 1}]}, "minecraft:custom_name": {bold: 1b, color: "#9999FF", italic: 0b, text: "夜留見酒"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "white", italic: 0b, text: "遠い場所の何処か、名もなき店で飲んだ酒。"}, {color: "white", italic: 0b, text: "記憶に残り、記録に残らず、"}, {color: "white", italic: 0b, text: "舌に残り、胃中に残らず。"}, {color: "white", italic: 0b, text: ""}, {color: "white", italic: 0b, text: "何度作り直しても、同じ味にはならない。"}], "minecraft:potion_contents": {custom_color: 9874431}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:potion"}
