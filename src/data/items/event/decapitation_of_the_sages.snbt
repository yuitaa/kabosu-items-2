{components: {"minecraft:custom_name": {bold: 1b, color: "dark_aqua", extra: [{color: "dark_red", text: "断頭台"}], italic: 0b, text: "賢人の"}, "minecraft:enchantments": {"minecraft:fortune": 5, "minecraft:silk_touch": 1}, "minecraft:lore": [{color: "dark_gray", extra: [{color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "愛したものは"}, {color: "dark_gray", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "裏切る為にある。"}, {color: "dark_purple", italic: 1b, text: ""}, {color: "gray", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "親しい者は"}, {color: "gray", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "利用する為にある。"}, {color: "dark_purple", italic: 1b, text: ""}, {color: "blue", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "謝罪は"}, {color: "blue", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "油断させる為にある。"}, {color: "dark_purple", italic: 1b, text: ""}, {color: "dark_green", extra: [{color: "dark_purple", italic: 1b, text: ""}], italic: 1b, text: "涙は騙す為にある。"}, {color: "dark_purple", italic: 1b, text: ""}, {color: "red", extra: [{color: "dark_purple", italic: 0b, text: ""}], italic: 1b, text: "全てが、醜い。"}, {color: "dark_purple", italic: 0b, text: ""}, {color: "dark_purple", italic: 0b, text: ""}], "minecraft:repair_cost": 999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:lectern"}
