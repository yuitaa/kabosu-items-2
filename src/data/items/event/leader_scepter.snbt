{components: {"minecraft:lore": [{color: "white", text: "掲げれば万衆が従い、揮えば祭典が動き出す。", italic: 0b}, {color: "white", text: "誰より前に立つ為でなく、誰もが楽しめる場を守るために。", italic: 0b}, {color: "white", text: "宴の始まりを告げ、歓声の終わりを見届ける主催者の証。", italic: 0b}], "minecraft:attribute_modifiers": [{amount: 1.0, id: "minecraft:1787694120035", slot: "mainhand", type: "minecraft:scale", operation: "add_value"}], "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {color: "#A658F3", text: "統率者の権杖", bold: 1b, italic: 0b}}, count: 1, id: "minecraft:breeze_rod"}
