{components: {"minecraft:lore": [{color: "white", text: "ある地方には、奇妙な言い伝えが遺されているという。", italic: 0b}, {color: "white", text: "使いきれなかった刻は、死と共に失われるのではない。", italic: 0b}, {color: "white", text: "誰も知らぬ場所へ運ばれ、小さな箱に収められるのだと。", italic: 0b}, "", {color: "#E1C2FF", text: "箱の中には、まだ訪れなかった朝がある。", italic: 0b}, {color: "#E1C2FF", text: "箱の中には、交わされなかった言葉がある。", italic: 0b}, {color: "#E1C2FF", text: "箱の中には、叶うことのなかった明日が、静かに眠っている。", italic: 0b}, "", {extra: [{color: "gray", text: "date: ", italic: 0b}, {color: "white", text: "2026/11/11", italic: 0b}], text: ""}, {extra: [{color: "gray", text: "event: ", italic: 0b}, {color: "white", text: "正体不明の棺桶２", italic: 0b}], text: ""}], "minecraft:enchantments": {"minecraft:silk_touch": 1}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {color: "#D2FEE7", text: "余命の棺", bold: 1b, italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:lodestone"}
