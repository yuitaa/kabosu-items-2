{components: {"minecraft:lore": [{color: "white", text: "景色は語ることはなく、違和は叫ぶことはない。", italic: 0b}, {color: "white", text: "虚実と真実は対立するとは限らない。", italic: 0b}, "", {color: "white", text: "賢者はその境界の秘奥に耳を傾け、", italic: 0b}, {color: "white", text: "愚者はその世界に手を振り下ろす。", italic: 0b}, "", {color: "white", text: "完成された絵画に残された一筆の揺らぎのように。", italic: 0b}, {color: "white", text: "閉じられた書物に挟まれた一片のしおりのように。", italic: 0b}, "", {color: "white", text: "いつもの \"それ\" は、いつしか眼前に。", italic: 0b}], "minecraft:attribute_modifiers": [{amount: 0.02, id: "minecraft:1789250585584", type: "minecraft:movement_speed", operation: "add_value"}, {amount: 1.0, id: "minecraft:1789250585585", type: "minecraft:step_height", operation: "add_value"}], "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {color: "#DDDF62", extra: [{color: "#D6D784", text: "見", bold: 1b, italic: 0b}, {color: "#CECFA5", text: "癥", bold: 1b, italic: 0b}, {color: "#C7C7C7", text: "結", bold: 1b, italic: 0b}, {color: "#E5EAC3", text: "の", bold: 1b, italic: 0b}, {color: "#E1E363", text: "石眼", bold: 1b, italic: 0b}], text: "洞", bold: 1b, italic: 0b}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:ender_eye"}
