{components: {"minecraft:custom_name": {bold: 1b, color: "aqua", italic: 0b, text: "第二かぼす丸"}, "minecraft:enchantments": {"minecraft:unbreaking": 3}, "minecraft:lore": [{color: "#9ACD32", text: "風がもつれりゃ吹雪にかわる"}, {color: "#9ACD32", italic: 1b, text: "のっけから時化は覚悟さ"}, {color: "#9ACD32", italic: 1b, text: "かかる飛沫を拳で拭い"}, {color: "#9ACD32", italic: 1b, text: "肌をさらして網を打つ"}, {color: "#9ACD32", italic: 1b, text: "沖のカモメに別れを告げて"}, {color: "#9ACD32", italic: 1b, text: "帰る潮路に舵を切る"}, {color: "#9ACD32", italic: 1b, text: ""}, {color: "#9ACD32", italic: 1b, text: "これが釣り人の命の証"}, {color: "#9ACD32", italic: 1b, text: "笑顔土産の大漁船だ"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:oak_boat"}
