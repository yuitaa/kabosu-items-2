{components: {"minecraft:attribute_modifiers": [{amount: 2.0, id: "minecraft:fffe1bf8-0000-1328-0001-9a9affffd9b0", operation: "add_value", slot: "head", type: "minecraft:max_health"}], "minecraft:custom_name": {bold: 1b, color: "#CC6699", italic: 0b, text: "夜の欠片"}, "minecraft:enchantments": {"minecraft:fortune": 3}, "minecraft:lore": [{color: "white", italic: 0b, text: "ときおり地上に現れる謎の結晶。"}, {color: "white", italic: 0b, text: "その輝きは黒色にくすんでおり、"}, {color: "white", italic: 0b, text: "見つめていると精神に異常をきたすという。"}, {color: "white", italic: 0b, text: ""}, {color: "white", italic: 0b, text: "蒐集家受けの良いコレクターアイテム。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:amethyst_shard"}
