{components: {"minecraft:lore": [{color: "white", text: "熟練の住民も、一見の旅人も 皆が空を見上げた夜。", italic: 0b}, {color: "white", text: "夜天を彩った祝宴の光が降り注ぎ、", italic: 0b}, {color: "white", text: "記憶の欠片となり形を残した。", italic: 0b}], "minecraft:attribute_modifiers": [{amount: 0.1, id: "minecraft:1787437439531", slot: "offhand", type: "minecraft:movement_speed", operation: "add_value"}], "minecraft:enchantments": {"minecraft:silk_touch": 1}, "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers", "minecraft:enchantments"]}, "minecraft:custom_name": {color: "#3DA9B8", text: "祝宴の欠片", bold: 1b, italic: 0b}}, count: 1, id: "minecraft:echo_shard"}
