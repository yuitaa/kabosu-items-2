{components: {"minecraft:custom_data": {cmdi: {command: "phoenixkit", params: "{}"}}, "minecraft:custom_name": {extra: [{bold: 1b, color: "light_purple", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "フェニックスキット", underlined: 0b}], text: ""}, "minecraft:lore": [{extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "体力を全回復し ♡ x 4 増やします。", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "red", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "10秒間移動できません。", underlined: 0b}], text: ""}]}, count: 1, id: "minecraft:dragon_breath"}
