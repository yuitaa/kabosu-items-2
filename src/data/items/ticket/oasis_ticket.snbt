{components: {"minecraft:custom_name": {bold: 1b, color: "aqua", italic: 0b, text: "オアシスチケット"}, "minecraft:enchantments": {"minecraft:fortune": 1}, "minecraft:lore": [{bold: 1b, color: "white", italic: 0b, text: "オアシスワールドを開拓するともらえるチケット。"}, {bold: 1b, color: "white", extra: [{bold: 0b, color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "専用のショップで使用することができる。"}, {color: "dark_purple", italic: 0b, text: ""}, {color: "yellow", italic: 0b, text: "イベント専用アイテム"}], "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:paper"}
