{components: {"minecraft:custom_name": {bold: 1b, color: "yellow", italic: 0b, text: "サーバーメニュー"}, "minecraft:enchantment_glint_override": 1b, "minecraft:lore": [{bold: 1b, color: "white", italic: 0b, text: "紙を持ってクリックすることで、"}, {bold: 1b, color: "white", extra: [{bold: 0b, color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "サーバーメニューを開きます。"}, {color: "gray", italic: 0b, text: "どの紙でもクリックすることでき、"}, {color: "gray", italic: 0b, text: "コマンド「/i」でも開くことができます。"}], "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:paper"}
