{components: {"minecraft:lore": [{extra: [{color: "white", text: "自称最速ボートレーサーのalbacore_tunaと", italic: 0b}], text: ""}, {extra: [{color: "white", text: "一騎打ちで対戦することが出来る。", italic: 0b}], text: ""}, {extra: [{color: "white", text: "勝利できれば様々な恩恵が受けられる？！", italic: 0b}], text: ""}, {extra: [{color: "gold", text: "レギュレーション：", italic: 0b}], text: ""}, {extra: [{color: "green", text: "場所", italic: 0b}], text: ""}, {extra: [{color: "white", text: "　公式ワープ「サーキット」から遊べる各種サーキット", italic: 0b}], text: ""}, {extra: [{color: "green", text: "順路・逆走", italic: 0b}], text: ""}, {extra: [{text: "　", italic: 0b}, {color: "white", text: "挑戦者が選べるものとする", italic: 0b}], text: ""}, {extra: [{color: "green", text: "周回数", italic: 0b}], text: ""}, {extra: [{text: "　", italic: 0b}, {color: "white", text: "３周", italic: 0b}], text: ""}, {extra: [{color: "green", text: "勝利商品", italic: 0b}], text: ""}, {extra: [{color: "white", text: "　かぼ主優待券１０枚", italic: 0b}], text: ""}, {extra: [{color: "white", text: "　かぼすフルーツ１０個", italic: 0b}], text: ""}, {extra: [{color: "white", text: "　保護領域ボーナス（勝ち方により変動）", italic: 0b}], text: ""}], "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}, "minecraft:custom_name": {extra: [{color: "red", text: "ボートレース挑戦券", bold: 1b, italic: 0b}], text: ""}, "minecraft:repair_cost": 9999}, count: 1, id: "minecraft:paper"}
