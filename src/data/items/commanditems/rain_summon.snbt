{components: {"minecraft:custom_data": {cmdi: {command: "PrivateWeather", params: "{}"}}, "minecraft:custom_name": {extra: [{bold: 1b, color: "aqua", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "天雨招来", underlined: 0b}], text: ""}, "minecraft:lore": [{extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "使用すると３分間、本人のみ雨が降ります。", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "サーバーの天気は変更されません。", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "使用可能エリア：", underlined: 0b}, {color: "green", italic: 0b, text: "資源ノーマル"}], text: ""}]}, count: 1, id: "minecraft:snowball"}
