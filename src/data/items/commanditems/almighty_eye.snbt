{components: {"minecraft:custom_data": {cmdi: {command: "scan", params: "{}"}}, "minecraft:custom_name": {extra: [{bold: 1b, color: "yellow", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "全能の目", underlined: 0b}], text: ""}, "minecraft:lore": [{extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "短い間だけ眼前の全構造物を見通して、", underlined: 0b}], text: ""}, {extra: [{bold: 0b, color: "white", italic: 0b, obfuscated: 0b, strikethrough: 0b, text: "敵や罠、手がかりを見破る。", underlined: 0b}], text: ""}]}, count: 1, id: "minecraft:ghast_tear"}
