{components: {"minecraft:attribute_modifiers": [{amount: 1.0, id: "minecraft:fffe1f1e-0000-12ea-0000-0fb8ffffda2c", operation: "add_value", slot: "mainhand", type: "minecraft:flying_speed"}], "minecraft:custom_name": {bold: 1b, color: "gold", italic: 0b, text: "無疑曰信"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "gray", text: "諸仏の智慧は甚深無量なり。"}, {color: "gray", italic: 1b, text: "其の智慧の門は難解難入なり。"}, {color: "gray", italic: 1b, text: "一切の声聞・辟支仏の知ること能わざる所なり。"}, {color: "gray", italic: 1b, text: "所以は何ん、仏曾て百千万億無数の諸仏に親近し、尽くして諸仏の無量の道法を行じ、勇猛精進して、名称普く聞えたまえり。"}, {color: "gray", italic: 1b, text: "甚深未曾有の法を成就して、宜しきに随って説きたもう所意趣解り難し。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments", "minecraft:unbreakable"]}, "minecraft:unbreakable": {}}, count: 1, id: "minecraft:book"}
