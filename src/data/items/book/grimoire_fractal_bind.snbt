{components: {"minecraft:attribute_modifiers": [{amount: -2.0, id: "minecraft:fffe1fda-0000-7410-0002-3558ffff17e0", operation: "add_value", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "dark_green", extra: [{color: "aqua", text: "「"}, {color: "gold", text: "フラクタルバインド"}, {color: "aqua", text: "」"}], italic: 0b, text: "魔導書"}, "minecraft:enchantments": {"minecraft:fire_aspect": 3, "minecraft:knockback": 15}, "minecraft:lore": [{color: "#FFCC99", text: "\" 制禦、悪意の紋章、蠢く奔流の彼方 \""}, {color: "#FFCC99", italic: 1b, text: "\" 己の無力を嘆き、絶望し \""}, {color: "#FFCC99", italic: 1b, text: "\" 六徳の狭間へ歿せよ \""}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers", "minecraft:enchantments"]}}, count: 1, id: "minecraft:enchanted_book"}
