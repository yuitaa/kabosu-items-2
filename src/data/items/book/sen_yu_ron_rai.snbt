{components: {"minecraft:attribute_modifiers": [{amount: 0.05, id: "minecraft:fffe1cb6-0000-1cb9-0002-9dbbffffc68e", operation: "add_value", slot: "mainhand", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "dark_aqua", extra: [{color: "blue", text: "「"}, {bold: 0b, color: "gold", text: "千駟趨雷原典"}, {color: "blue", text: "」"}], italic: 0b, text: "兵法"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "light_purple", italic: 0b, text: "\"　兵は拙速を聞くも、未だ巧の久しきを睹ざるなり"}, {color: "light_purple", italic: 0b, text: " 夫れ兵久しくして國に利するは、未だ之有らざるなり　\""}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:enchantments"]}}, count: 1, id: "minecraft:book"}
