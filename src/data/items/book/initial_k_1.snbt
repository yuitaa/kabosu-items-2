{components: {"minecraft:attribute_modifiers": [{amount: 0.03, id: "minecraft:ffffcfef-0000-57a4-0000-535affff50b8", operation: "add_value", slot: "mainhand", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "gold", extra: [{bold: 0b, italic: 0b, text: " "}, {bold: 0b, color: "dark_gray", italic: 0b, text: "／第１巻"}], text: "頭文字Ｋ"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "gray", text: "坑道最速理論───"}, {color: "gray", italic: 1b, text: ""}, {color: "gray", italic: 1b, text: "\"ストレートで速い走り屋は初心者、"}, {color: "gray", italic: 1b, text: "コーナーを極めて中級者、上級者ともなれば、"}, {color: "gray", italic: 1b, text: "ストレートでもコーナーでもない第三のポイントで差をつける。"}, {color: "gray", italic: 1b, text: "そのポイントを見極めることこそが、最速理論のメインテーマだ。\""}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers", "minecraft:enchantments"]}}, count: 1, id: "minecraft:book"}
