{components: {"minecraft:custom_name": {color: "gold", italic: 0b, text: "開拓作業者の日誌"}, "minecraft:lore": [{italic: 0b, text: ""}, {color: "dark_aqua", italic: 0b, text: "街のはずれの開拓地で見つかった、"}, {color: "dark_aqua", italic: 0b, text: "とある開拓作業者の日誌。"}, {color: "dark_aqua", italic: 0b, text: ""}, {color: "dark_aqua", italic: 0b, text: "都市に眠る大きな秘密の存在を"}, {color: "dark_aqua", italic: 0b, text: "偶然発見してしまったという内容が書かれている。"}], "minecraft:stored_enchantments": {"minecraft:efficiency": 5, "minecraft:mending": 1, "minecraft:unbreaking": 3}}, count: 1, id: "minecraft:enchanted_book"}
