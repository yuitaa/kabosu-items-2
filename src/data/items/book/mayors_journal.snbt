{components: {"minecraft:custom_name": {color: "gold", italic: 0b, text: "市長の手記"}, "minecraft:lore": [{italic: 0b, text: ""}, {color: "blue", italic: 0b, text: "とある都市の市長が持っていた手記。"}, {color: "blue", italic: 0b, text: ""}, {color: "blue", italic: 0b, text: "都市に眠る大きな秘密の存在を"}, {color: "blue", italic: 0b, text: "偶然見つけてしまった男を探し出すために、"}, {color: "blue", italic: 0b, text: "奮闘する様が書かれている。"}], "minecraft:stored_enchantments": {"minecraft:mending": 1, "minecraft:protection": 4, "minecraft:thorns": 3, "minecraft:unbreaking": 3}}, count: 1, id: "minecraft:enchanted_book"}
