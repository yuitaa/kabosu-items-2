{components: {"minecraft:attribute_modifiers": [{amount: 8.0, id: "minecraft:fffe1cad-0000-319f-0000-0b88ffff9cc2", operation: "add_value", slot: "head", type: "minecraft:max_health"}, {amount: 6.0, id: "minecraft:fffe1cad-0000-3203-0000-0b88ffff9bfa", operation: "add_value", slot: "offhand", type: "minecraft:attack_damage"}, {amount: 0.05, id: "minecraft:fffe1cad-0000-3267-0000-0b88ffff9b32", operation: "add_value", slot: "mainhand", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "gold", italic: 0b, text: "サティヤ・ドヴァヤの神典"}, "minecraft:enchantments": {"minecraft:mending": 1}, "minecraft:lore": [{color: "red", extra: [{color: "dark_purple", text: ""}], text: "真俗二諦を理解せよ。"}, {color: "dark_purple", italic: 1b, text: ""}, {bold: 1b, color: "white", italic: 1b, text: "往生を不定に思召し者は、"}, {bold: 1b, color: "white", italic: 1b, text: "まず我が身の往生を思召して御念仏候ふべし。"}, {bold: 1b, color: "white", italic: 1b, text: ""}, {bold: 1b, color: "white", italic: 1b, text: "我が身の往生一定と思召し者は、"}, {bold: 1b, color: "white", italic: 1b, text: "仏の御恩を思召し、"}, {bold: 1b, color: "white", italic: 1b, text: "ご報恩の為に御念仏を心に入れ申して、"}, {bold: 1b, color: "white", italic: 1b, text: "世の中安寧なれ、仏法ひろまれと思召すべしとおぼえ候ふ。"}, {bold: 1b, color: "white", italic: 1b, text: ""}, {bold: 1b, color: "white", italic: 1b, text: "よくよく御案候ふべし。"}, {bold: 1b, color: "white", italic: 1b, text: ""}, {bold: 1b, color: "white", italic: 1b, text: "このほかは、別の御はからひあるべしとはおぼえず候ふ。"}], "minecraft:repair_cost": 9999, "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers", "minecraft:enchantments"]}}, count: 1, id: "minecraft:book"}
