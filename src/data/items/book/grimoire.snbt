{components: {"minecraft:attribute_modifiers": [{amount: -10.0, id: "minecraft:fffe242b-0000-af27-0002-a9cffffea1b2", operation: "add_value", type: "minecraft:max_health"}, {amount: -0.1, id: "minecraft:fffe242b-0000-af8b-0002-a9cffffea0ea", operation: "add_value", type: "minecraft:movement_speed"}], "minecraft:custom_name": {bold: 1b, color: "dark_red", extra: [" ", {color: "dark_purple", text: "†グリモワール†"}], italic: 0b, text: "禁断書物"}, "minecraft:enchantments": {"minecraft:binding_curse": 1, "minecraft:vanishing_curse": 1}, "minecraft:lore": [{italic: 0b, text: ""}, {color: "dark_purple", italic: 0b, text: "ある男の漆黒の歴史が刻まれた小汚い書物。"}, {color: "dark_purple", italic: 0b, text: "手に持つと著者の呪いと怨恨が襲い掛かる。"}, {color: "dark_purple", italic: 0b, text: "そして、著者自体も不幸に見舞われるという。"}], "minecraft:tooltip_display": {hidden_components: ["minecraft:attribute_modifiers"]}}, count: 1, id: "minecraft:book"}
