{components: {"minecraft:custom_name": {bold: 1b, color: "blue", italic: 0b, text: "生殺与奪剣"}, "minecraft:damage": 130, "minecraft:lore": [{color: "white", italic: 0b, text: "生かしたり殺したり、"}, {color: "white", italic: 0b, text: "与えたり奪ったり、すなわち、"}, {color: "white", extra: [{color: "dark_purple", italic: 0b, text: ""}], italic: 0b, text: "どうしようと自分の思うままである剣。"}, {color: "dark_purple", italic: 0b, text: ""}, {color: "gray", italic: 0b, text: "出典：ビ〇クモーター"}], "minecraft:repair_cost": 999}, count: 1, id: "minecraft:stone_sword"}
