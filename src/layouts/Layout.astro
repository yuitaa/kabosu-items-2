---
interface Props {
  title?: string;
}

const { title = 'Kabosu Items' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">Kabosu Items</a>
      <nav aria-label="メインナビゲーション">
        <a href="/">アイテム一覧</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
