---
import DiscordAnsi from '@/components/item/DiscordAnsi.astro';
import ItemTooltip from '@/components/item/ItemTooltip.astro';
import type { ItemPresentation } from '@/lib/minecraft/item/presentation';

interface Props {
  presentation: ItemPresentation;
}

const { presentation } = Astro.props;
---

<div class="item-preview">
  <div class="item-preview-panel mb-2" data-panel="tooltip">
    <ItemTooltip presentation={presentation} />
  </div>

  <div class="item-preview-panel" data-panel="ansi">
    <DiscordAnsi presentation={presentation} />
  </div>
</div>
