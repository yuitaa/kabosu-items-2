---
import type * as v from 'valibot';

interface Props {
  issues: readonly v.BaseIssue<unknown>[];
}

const { issues } = Astro.props;
---

<ul class="issue-list">
  {issues.map((issue) => (
    <li>
      {issue.path && issue.path.length > 0 && <code>{issue.path.map((item) => String(item.key)).join('.')}</code>}
      {issue.message}
    </li>
  ))}
</ul>
