---
import IssueList from '@/components/item/IssueList.astro';
import Value from '@/components/value/Value.astro';
import type { ComponentView } from '@/lib/minecraft/item/load';

interface Props {
  entry: ComponentView;
}

const { entry } = Astro.props;
---

<div class="component-row">
  <dt>
    <code>{entry.id}</code>
    {entry.kind !== 'valid' && <span data-status={entry.kind}>{entry.kind}</span>}
  </dt>
  <dd>
    <Value value={entry.kind === 'valid' ? entry.value : entry.raw} />
    {entry.kind === 'invalid' && <IssueList issues={entry.issues} />}
  </dd>
</div>
