---
import TextSpans from '@/components/item/TextSpans.astro';
import { groupAttributes, type ItemPresentation } from '@/lib/minecraft/item/presentation';

interface Props {
  presentation: ItemPresentation;
}

const { presentation } = Astro.props;
const attributeGroups = groupAttributes(presentation.attributes);
const aboveLoreExtras = presentation.extras.filter((extra) => !extra.afterLore);
const belowLoreExtras = presentation.extras.filter((extra) => extra.afterLore);
---

<div class="item-tooltip">
  <div class="item-name">
    <TextSpans spans={presentation.name} />
  </div>

  {presentation.firework && (
    <div class="item-effect-group">
      <div class="item-firework-flight">{presentation.firework.flightText}</div>
      {presentation.firework.explosions.map((explosion) => (
        <div class="item-firework-explosion">
          <div class="item-firework-shape">
            {explosion.shape}
            {explosion.count > 1 && ` x ${explosion.count}`}
          </div>
          <div class="item-firework-details">
            {explosion.colors.map((color) => (
              <div class="item-firework-color">{color.name ?? color.hex}</div>
            ))}
            {explosion.fadeColors.length > 0 && (
              <div class="item-firework-color">
                {explosion.fadeLabel}
                {explosion.fadeColors.map((color, index) => (
                  <>
                    {index > 0 && ' '}
                    {color.name ?? color.hex}
                  </>
                ))}
              </div>
            )}
            {explosion.effects.map((effect) => (
              <div class="item-firework-effect">{effect}</div>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  {presentation.enchantments.length > 0 && (
    <div class="item-effect-group">
      {presentation.enchantments.map((row) => (
        <div class="item-enchantment">
          {row.name} {row.levelLabel}
        </div>
      ))}
    </div>
  )}

  {presentation.potions.length > 0 && (
    <div class="item-effect-group">
      {presentation.potions.map((row) => (
        <div class="item-potion">
          {[row.name, row.levelLabel, row.duration && `(${row.duration})`].filter(Boolean).join(' ')}
        </div>
      ))}
    </div>
  )}

  {aboveLoreExtras.length > 0 && (
    <div class="item-effect-group">
      {aboveLoreExtras.map((extra) => (
        <div class="item-extra">{extra.text}</div>
      ))}
    </div>
  )}

  {presentation.banner && (
    <div class="item-effect-group item-banner">
      {presentation.banner.baseColor && (
        <div class="item-extra">
          {presentation.banner.baseColorLabel} {presentation.banner.baseColor}
        </div>
      )}
      {presentation.banner.patterns.length > 0 && (
        <div class="item-banner-patterns">
          <div class="item-banner-header">{presentation.banner.patternsLabel}</div>
          {presentation.banner.patterns.map((pattern) => (
            <div class="item-extra">{pattern.text}</div>
          ))}
        </div>
      )}
    </div>
  )}

  {presentation.lore.length > 0 && (
    <div class="item-lore-group">
      {presentation.lore.map((line) => (
        <div class="item-lore">
          <TextSpans spans={line} />
        </div>
      ))}
    </div>
  )}

  {attributeGroups.length > 0 && (
    <div class="item-effect-group">
      {attributeGroups.map((group) => (
        <div class="item-attribute-group">
          <div class="item-attribute-header">{group.header}</div>
          {group.rows.map((row) => (
            <div class="item-attribute">{row.text}</div>
          ))}
        </div>
      ))}
    </div>
  )}

  {belowLoreExtras.length > 0 && (
    <div class="item-effect-group">
      {belowLoreExtras.map((extra) => (
        <div class="item-extra">{extra.text}</div>
      ))}
    </div>
  )}
</div>

<style>
  .item-enchantment,
  .item-attribute-header {
    color: #aaaaaa;
  }

  .item-attribute,
  .item-potion,
  .item-extra {
    color: #5555ff;
  }

  .item-effect-group + .item-effect-group,
  .item-effect-group + .item-lore-group,
  .item-lore-group + .item-effect-group,
  .item-name + .item-lore-group {
    margin-block-start: 1em;
  }

  .item-firework-flight,
  .item-firework-shape,
  .item-banner-header {
    color: #aaaaaa;
  }

  .item-firework-details {
    padding-inline-start: 1em;
  }

  .item-firework-color,
  .item-firework-effect,
  .item-banner .item-extra {
    color: #aaaaaa;
  }

  .item-firework-explosion + .item-firework-explosion {
    margin-block-start: 0.5em;
  }

  .item-banner-patterns .item-extra {
    padding-inline-start: 1em;
  }
</style>
