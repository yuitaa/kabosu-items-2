---
import GiveCommand from '@/components/item/GiveCommand.astro';
import ItemPreview from '@/components/item/ItemPreview.astro';
import SnbtCode from '@/components/item/SnbtCode.astro';
import TextSpans from '@/components/item/TextSpans.astro';
import { itemEntries } from '@/data/item-views';
import Layout from '@/layouts/Layout.astro';
import { buildGiveCommand } from '@/lib/minecraft/item/give';
import { groupAttributes } from '@/lib/minecraft/item/presentation';
import { effectWikiUrl, enchantmentWikiUrl } from '@/lib/minecraft/wiki';

export function getStaticPaths() {
  return itemEntries.map(({ view }) => ({
    params: { slug: view.source.slug },
  }));
}

const { slug } = Astro.params;
const entry = itemEntries.find((candidate) => candidate.view.source.slug === slug);

if (!entry) {
  throw new Error(`Item not found: ${slug}`);
}

const { view, presentation } = entry;
const attributeGroups = groupAttributes(presentation.attributes);

const root = view.root;
const componentsTag = root?.isCompound() && root.hasCompound('components') ? root.getCompound('components') : null;
const componentsSnbt = componentsTag && componentsTag.size > 0 ? `components: ${componentsTag.toPrettyString()}` : null;

const giveCommand = buildGiveCommand(root);
if (!giveCommand) {
  throw new Error(`Could not build give command: ${slug}`);
}

const ogImage = `/og/${view.source.slug}.png`;
const ogImageAlt = `「${presentation.plainName}」のアイテムツールチップ`;
---

<Layout
  title={`${presentation.plainName} | Kabosu Items 2`}
  type="article"
  image={ogImage}
  imageAlt={ogImageAlt}
  imageWidth={1200}
  imageHeight={630}>
  <h1 class="mb-2 border-l-4 border-emerald-700 bg-gray-900 p-2 pl-4 text-2xl">
    <TextSpans spans={presentation.name} />
  </h1>

  <section aria-labelledby="item-preview-heading" class="float-right w-full md:ml-2 md:w-80">
    <ItemPreview presentation={presentation} />
  </section>

  <section aria-labelledby="item-basic-heading mb-2">
    <h2 id="item-basic-heading" class="text-xl font-bold">
      情報
    </h2>
    <dl class="pl-6">
      <dt>アイテム名</dt>
      <dd class="pl-6 text-gray-600">{presentation.itemName}</dd>
      <dt>Minecraft ID</dt>
      <dd class="pl-6 text-gray-600">
        <code>{view.item?.id ?? view.source.slug}</code>
      </dd>
      <dt>不可壊</dt>
      <dd class="pl-6 text-gray-600">{presentation.unbreakable ? 'あり' : 'なし'}</dd>
      {presentation.dyedColor && (
        <>
          <dt>染色済み</dt>
          <dd class="pl-6 text-gray-600">
            <span class="item-swatch" style={`background-color: ${presentation.dyedColor}`} aria-hidden="true" />
            {presentation.dyedColor}
          </dd>
        </>
      )}
      {presentation.trim && (
        <>
          <dt>装飾</dt>
          <dd class="pl-6 text-gray-600">{presentation.trim.text}</dd>
        </>
      )}
    </dl>
  </section>

  {presentation.enchantments.length > 0 && (
    <section aria-labelledby="item-enchantments-heading mb-2">
      <h2 id="item-enchantments-heading" class="text-xl font-bold">
        エンチャント
      </h2>
      <div class="grid grid-cols-2 pl-6">
        <div class="bg-gray-200 px-2">名前</div>
        <div class="bg-gray-200 px-2">レベル</div>

        {presentation.enchantments.map((row) => (
          <>
            <div class="px-2 py-1 underline">
              <a href={enchantmentWikiUrl(row.name)}>{row.name}</a>
            </div>
            <div class="px-2 py-1">{row.level}</div>
          </>
        ))}
      </div>
    </section>
  )}

  {attributeGroups.length > 0 && (
    <section aria-labelledby="item-attributes-heading">
      <h2 id="item-attributes-heading" class="text-xl font-bold">
        追加効果
      </h2>
      <div class="grid grid-cols-2 pl-6">
        <div class="bg-gray-200 px-2">名前</div>
        <div class="bg-gray-200 px-2">値</div>

        {attributeGroups.map((group) => (
          <>
            <div class="col-span-2 bg-gray-100 px-2 py-1 font-bold">{group.header}</div>
            {group.rows.map((row) => (
              <>
                <div class="px-2 py-1">{row.name}</div>
                <div class="px-2 py-1">{row.value}</div>
              </>
            ))}
          </>
        ))}
      </div>
    </section>
  )}

  {presentation.potions.length > 0 && (
    <section aria-labelledby="item-potions-heading">
      <h2 id="item-potions-heading">ポーション効果</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">名前</th>
            <th scope="col">レベル</th>
            <th scope="col">時間</th>
          </tr>
        </thead>
        <tbody>
          {presentation.potions.map((row) => (
            <tr>
              <td>
                <a href={effectWikiUrl(row.name)}>{row.name}</a>
              </td>
              <td>{row.level}</td>
              <td>{row.duration}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section aria-labelledby="item-give-heading mb-2">
    <h2 id="item-give-heading" class="text-xl font-bold">
      Give Command
    </h2>
    <div class="pl-6">
      <GiveCommand command={giveCommand} />
    </div>
  </section>

  <section aria-labelledby="item-components-heading">
    <h2 id="item-components-heading" class="text-xl font-bold">
      コンポーネント
    </h2>
    <div class="pl-4">{componentsSnbt ? <SnbtCode code={componentsSnbt} /> : <p>コンポーネントはありません。</p>}</div>
  </section>
</Layout>

<style>
  .item-swatch {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    border: 1px solid currentColor;
    vertical-align: middle;
  }
</style>
