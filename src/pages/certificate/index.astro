---
import { certificateJobs, certificateRows, certificateTitle } from '@/data/certificates';
import Layout from '@/layouts/Layout.astro';
import { withBase } from '@/lib/site';

const jobs = certificateJobs.map((job) => ({
  ...job,
  rows: certificateRows(job),
}));
---

<Layout title="資格証明書一覧 | Kabosu Items 2" description="かぼすサーバーのジョブで獲得できる資格証明書の一覧です。">
  <h1 class="text-2xl font-bold">資格証明書</h1>
  {jobs.map((job) => (
    <section aria-labelledby={`job-${job.slug}`} class="mt-2 pl-6">
      <h2 id={`job-${job.slug}`} class="text-xl">
        {job.name}
      </h2>
      <div class="pl-6">
        {job.rows.map(({ level, entry }) => (
          <div>
            <span class="mr-4 font-bold">Lv.{level}</span>
            <span>
              {entry ? (
                <a href={withBase(`/${entry.view.source.slug}`)} class="underline">
                  {certificateTitle(entry)}
                </a>
              ) : (
                <span class="text-gray-600">???</span>
              )}
            </span>
          </div>
        ))}
      </div>
    </section>
  ))}
</Layout>
